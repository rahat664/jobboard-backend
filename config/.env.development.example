# ===========================
# Development configuration
# ===========================
NODE_ENV=development
PORT=3000

# MongoDB (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/jobboard_dev
# or: mongodb+srv://<user>:<ENCODED_PASS>@<cluster>.mongodb.net/jobboard_dev

# Admin credentials (for POST /jobs basic auth)
ADMIN_USER=devAdmin
ADMIN_PASS=devPass

# Swagger (dev usually enabled)
SWAGGER_ENABLED=true
SWAGGER_USER=docs
SWAGGER_PASS=docs123

# CORS (comma-separated origins or * for all)
CORS_ORIGIN=*
